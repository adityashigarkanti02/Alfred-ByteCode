# ==============================================================================
# ALFRED AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Database Connection
# Default SQLite local database: sqlite:///./alfred.db
# For PostgreSQL container: postgresql://alfred:alfred_secret_password@localhost:5432/alfred_db
DATABASE_URL=sqlite:///./alfred.db

# Cryptographic Capability Signing Secret
# Set to a strong random key in production environments
ALFRED_CAPABILITY_SECRET=alfred-deterministic-master-secret-key-change-in-prod-5847382910

# Local Companion Authentication Secret
# Shared token between backend API and local companion PC agent
ALFRED_COMPANION_SECRET=alfred-companion-secure-token-local-99218204

# Local Companion Configuration
COMPANION_URL=http://127.0.0.1:8001
COMPANION_PORT=8001
ALFRED_SANDBOX_DIR=./workspace_sandbox

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
PORT=3000

# LLM Provider API Keys (Optional - ALFRED includes high-fidelity deterministic offline planning)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Google Gmail API OAuth 2.0 (Optional - ALFRED includes full sandbox inbox by default)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/gmail/callback
